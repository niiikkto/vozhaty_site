# ======================================
# .env.demo.example - Демо-конфигурация для проекта "Вожатка"
# ======================================
# Инструкция: скопируй в .env.demo и запусти docker compose up
# Это безопасный файл без реальных паролей!

# Режим приложения
APP_ENV=demo
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# Секретный ключ (для демо подойдет сгенерированный)
SECRET_KEY=demo-insecure-key-for-testing-only

# База данных - SQLite, но в Docker томе
DATABASE_URL=sqlite:///db.sqlite3

# Разрешенные хосты (для демо-стенда)
ALLOWED_HOSTS=localhost,127.0.0.1

# Настройки почты (для демо не нужны)
SMTP_HOST=localhost
SMTP_PORT=1025

# Безопасность (для демо отключаем)
DEBUG=True